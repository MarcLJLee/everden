## 이 문자열이 몇 픽셀인가 (배율 1 기준)
static func measure(text: String) -> Vector2i:
	var length := text.length()
	if length == 0:
		return Vector2i.ZERO
	return Vector2i(length * ADVANCE - 1, GLYPH_H)


## CanvasItem 의 _draw 안에서 부른다. at 은 좌상단.
static func draw(canvas: CanvasItem, text: String, at: Vector2, color: Color,
		scale := 2, shadow_color := Color(0, 0, 0, 0.75)) -> void:
	if shadow_color.a > 0.0:
		_draw_mask(canvas, text, at + Vector2.ONE * scale, color_of(shadow_color), scale)
	_draw_mask(canvas, text, at, color, scale)


static func color_of(color: Color) -> Color:
	return color


static func _draw_mask(canvas: CanvasItem, text: String, at: Vector2, color: Color, scale: int) -> void:
	var upper := text.to_upper()
	for i in upper.length():
		var rows: PackedStringArray = String(GLYPHS.get(upper[i], GLYPHS[" "])).split("/")
		for y in rows.size():
			var row := rows[y]
			for x in row.length():
				if row[x] == "1":
					canvas.draw_rect(Rect2(
						at + Vector2((i * ADVANCE + x) * scale, y * scale),
						Vector2.ONE * scale), color)
